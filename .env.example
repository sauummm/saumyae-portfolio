# Resend (https://resend.com) — used by the contact form Server Action (lib/actions.ts)
RESEND_API_KEY=

# Where contact-form submissions are delivered
CONTACT_TO_EMAIL=

# Verified Resend sender address. Resend's shared onboarding domain
# (onboarding@resend.dev) works with zero setup; switch to a verified
# custom-domain address once one exists.
CONTACT_FROM_EMAIL=
